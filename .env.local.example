# Anthropic API 키 (서버에서만 사용, 절대 클라이언트에 노출 금지)
ANTHROPIC_API_KEY=sk-ant-...

# 사용 모델 — 비우면 기본값(engine/models.ts)이 적용된다.
# 지금은 품질 우선 단계라 기본값이 둘 다 claude-opus-5다.
# 저렴한 모델로 내리는 조건은 docs/model-policy.md의 기준을 따른다.
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MODEL_LIGHT=claude-opus-5

# 비용 보호장치 — 기본값은 IP당 분당 6회, 전체 일일 300회, 본문 텍스트 4,000자다.
GUARD_RPM=6
GUARD_DAILY=300
GUARD_MAX_INPUT=4000
# 로컬 개발에서만 가드를 끌 때 사용한다. 공개 배포에서는 설정하지 않는다.
# GUARD_DISABLED=1

# Vercel KV REST — 두 값을 모두 설정해야 인스턴스 간 공유 카운터가 활성화된다.
# KV를 붙이지 않으면 레이트리밋은 서버리스 인스턴스별 best-effort로 떨어진다.
# KV_REST_API_URL=https://your-kv-instance.upstash.io
# KV_REST_API_TOKEN=your-kv-token

# identity-linked API key(계정 연결 키)를 쓰는 경우 필수 — 없으면 모든 호출이 400.
# Anthropic Console → Settings → Workspaces에서 확인 (wrkspc_로 시작)
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
